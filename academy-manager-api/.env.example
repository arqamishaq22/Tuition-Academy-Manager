# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=academy_manager

# JSON Web Token Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client Application URL (for CORS and Cookies)
CLIENT_URL=http://localhost:3000
COOKIE_SECURE=false
